# uns-productivity — Production Run Logger
# Connection config only — topic config lives in Valkey cache

# Function name = Valkey config key (fnkit:config:uns-productivity)
FUNCTION_TARGET=uns-productivity

# PostgreSQL connection
DATABASE_URL=postgres://fnkit:fnkit@fnkit-postgres:5432/fnkit?sslmode=disable

# Valkey/Redis cache (must match uns-framework)
CACHE_URL=redis://fnkit-cache:6379
CACHE_KEY_PREFIX=uns
